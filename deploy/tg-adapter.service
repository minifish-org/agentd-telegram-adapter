[Unit]
Description=Rust Telegram webhook to agentd adapter
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=agentd-tg-adapter
WorkingDirectory=/var/lib/agentd-tg-adapter
EnvironmentFile=/etc/tg-adapter.env
EnvironmentFile=/etc/tg-adapter-decoy.env
ExecStart=/usr/local/lib/agentd-telegram-adapter/current/agentd-telegram-adapter
Restart=on-failure
RestartSec=2s
MemoryMax=128M
UMask=0077

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectHostname=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
