# Copy to /etc/tg-adapter.env and replace every placeholder before production use.
BOT_TOKEN=replace-with-telegram-bot-token
WEBHOOK_SECRET=replace-with-random-webhook-secret

AGENTD_URL=http://127.0.0.1:8080
AGENTD_TOKEN=
TENANT=demo
AGENT_REF=simple-bot

AUDIO_API_BASE=http://127.0.0.1:8000/v1
AUDIO_API_KEY=
ASR_MODEL=local/asr
TTS_MODEL=local/tts
TTS_VOICE=default

LISTEN_HOST=127.0.0.1
LISTEN_PORT=18080
WEBHOOK_PATH=/tg/webhook
ALLOWED_TG_USERS=123456789
